---
import BaseLayout from "../layouts/BaseLayout.astro";
import { collectTags, entryCoverImage, entryDefaultCoverImage, entryLocation, entrySlug, formatDate, getPublishedEntries, typeLabels } from "../lib/entries";
import { getLatestXPosts } from "../lib/x-posts";

const entries = await getPublishedEntries();
const tags = collectTags(entries).slice(0, 14);
const xPosts = await getLatestXPosts(5);
const visibleEntryLimit = 8;
const hasMoreEntries = entries.length > visibleEntryLimit;

function formatXDate(date?: string) {
  if (!date) return "X";
  const parsed = new Date(date);
  if (Number.isNaN(parsed.valueOf())) return "X";
  return new Intl.DateTimeFormat("zh-CN", {
    month: "short",
    day: "numeric"
  }).format(parsed);
}
---

<BaseLayout>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <h1>東嬉遊記</h1>
        <p class="lede">把一次温泉、一段车程、一间酒店和一座城市，慢慢写成可以回望、检索、继续生长的旅行笔记。</p>
      </div>
      <aside class={xPosts.length > 0 ? "x-panel has-posts" : "x-panel"} aria-label="X">
        <a class="x-link" href="https://x.com/don_tsua" target="_blank" rel="noopener noreferrer" aria-label="打开 @don_tsua 的 X 主页">
          <span class="x-logo-mark" aria-hidden="true">
            <img src="/images/x-logo.svg" alt="" width="20" height="20" />
          </span>
          <span class="x-profile-copy">
            <span class="x-eyebrow">@don_tsua</span>
            {xPosts.length === 0 && <small>新的行程、照片和临时想法，会先落在这里。</small>}
          </span>
        </a>
        {xPosts.length > 0 && (
          <div class="x-posts">
            {xPosts.map((post) => (
              <a class="x-post" href={post.url} target="_blank" rel="noopener noreferrer">
                <img class="x-post-avatar" src="/images/dongxi-avatar.jpg" alt="" width="40" height="40" />
                <span class="x-post-content">
                  <span class="x-post-meta">
                    <strong>東嬉遊記</strong>
                    <span>@don_tsua</span>
                    <span>·</span>
                    <time datetime={post.createdAt}>{formatXDate(post.createdAt)}</time>
                  </span>
                  <p>{post.text}</p>
                </span>
              </a>
            ))}
          </div>
        )}
      </aside>
    </section>

    <section id="records" class="content-band">
      <div class="section-heading records-heading">
        <h2>全部记录</h2>
        <label class="entry-search">
          <span class="sr-only">搜索记录</span>
          <input type="search" placeholder="搜索标题、摘要或地点" autocomplete="off" data-entry-search />
        </label>
      </div>
      <div class="entry-grid">
        {entries.map((entry, index) => {
          const location = entryLocation(entry) || entry.data.country;
          const searchableText = [entry.data.title, entry.data.summary, location, typeLabels[entry.data.type]]
            .filter(Boolean)
            .join(" ")
            .toLocaleLowerCase("zh-CN");

          return (
            <article
              class={index >= visibleEntryLimit ? "entry-card is-extra" : "entry-card"}
              data-entry-card
              data-search={searchableText}
              data-extra={index >= visibleEntryLimit ? "true" : undefined}
              hidden={index >= visibleEntryLimit}
            >
              <a href={`/entries/${entrySlug(entry)}`}>
                <span class="entry-cover">
                  <img src={entryCoverImage(entry, index)} data-fallback-src={entryDefaultCoverImage(index)} alt="" loading="lazy" />
                </span>
                <span class="entry-meta">{typeLabels[entry.data.type]} · {formatDate(entry.data.date)}</span>
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
                <span class="entry-place">{location}</span>
              </a>
            </article>
          );
        })}
      </div>
      <p class="search-empty" data-search-empty hidden>没有找到匹配的记录。</p>
      {hasMoreEntries && (
        <div class="more-row" data-more-row>
          <button class="more-button" type="button" data-show-more>更多</button>
        </div>
      )}
    </section>

    <section class="content-band compact">
      <div class="section-heading">
        <p class="kicker">AI tags</p>
        <h2>语义标签</h2>
      </div>
      <div class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <a href={`/tags/${encodeURIComponent(tag)}`}>{tag}<span>{count}</span></a>
        ))}
      </div>
    </section>
  </main>
  <script is:inline>
    const searchInput = document.querySelector("[data-entry-search]");
    const entryCards = Array.from(document.querySelectorAll("[data-entry-card]"));
    const searchEmpty = document.querySelector("[data-search-empty]");
    const showMoreButton = document.querySelector("[data-show-more]");
    const moreRow = document.querySelector("[data-more-row]");
    let expanded = false;

    const restoreDefaultVisibility = () => {
      entryCards.forEach((entry) => {
        entry.hidden = !expanded && entry.dataset.extra === "true";
      });
      if (moreRow) moreRow.hidden = expanded;
      if (searchEmpty) searchEmpty.hidden = true;
    };

    searchInput?.addEventListener("input", () => {
      const query = searchInput.value.trim().toLocaleLowerCase("zh-CN");
      if (!query) {
        restoreDefaultVisibility();
        return;
      }

      let matchCount = 0;
      entryCards.forEach((entry) => {
        const matches = (entry.dataset.search || "").includes(query);
        entry.hidden = !matches;
        if (matches) matchCount += 1;
      });

      if (moreRow) moreRow.hidden = true;
      if (searchEmpty) searchEmpty.hidden = matchCount > 0;
    });

    showMoreButton?.addEventListener("click", () => {
      expanded = true;
      restoreDefaultVisibility();
    });
  </script>
</BaseLayout>

<style>
  .records-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
  }

  .entry-search {
    width: min(360px, 100%);
  }

  .entry-search input {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 10px;
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .entry-search input:focus {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-empty {
    margin: 22px 0 0;
    opacity: 0.65;
  }

  @media (max-width: 640px) {
    .records-heading {
      align-items: stretch;
      flex-direction: column;
    }

    .entry-search {
      width: 100%;
    }
  }
</style>
