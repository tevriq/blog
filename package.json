{
  "name": "dongxi-voyage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "enrich:obsidian": "node scripts/enrich-obsidian.mjs",
    "import:obsidian": "node scripts/import-obsidian.mjs",
    "share:cards": "node scripts/generate-share-cards.mjs",
    "sync:x": "node scripts/sync-x-posts.mjs",
    "tag": "node scripts/ai-tagger.mjs",
    "validate": "node scripts/validate-content.mjs",
    "validate:ai": "node scripts/validate-ai-directives.mjs",
    "media:publish": "node scripts/publish-media.mjs",
    "media:resolve": "node scripts/resolve-obsidian-images.mjs",
    "preflight:local": "node scripts/preflight-publish.mjs",
