    "publish:local": "npm run import:obsidian && npm run tag && npm run validate:ai && npm run validate && npm run build -- --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "astro": "^7.0.6",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.3"
